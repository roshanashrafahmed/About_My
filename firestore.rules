rules_version = '2';

// Visitors may only ADD view / enquiry records. Only the owner, signed in with
// Google, can read or delete them. Replace the email below with the owner's
// Google account (it must match VITE_OWNER_EMAIL in .env.local).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'roshankurshankmb@gmail.com';
    }

    function validView(d) {
      return d.keys().hasOnly(['type', 'createdAt', 'referrer', 'lang'])
        && d.referrer is string && d.referrer.size() <= 200
        && d.lang is string && d.lang.size() <= 20;
    }

    function validEnquiry(d) {
      return d.keys().hasOnly(['type', 'createdAt', 'name', 'email', 'message'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && d.email.size() <= 150
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000;
    }

    match /events/{eventId} {
      allow create: if request.resource.data.createdAt == request.time
        && ((request.resource.data.type == 'view' && validView(request.resource.data))
          || (request.resource.data.type == 'enquiry' && validEnquiry(request.resource.data)));
      allow read, delete: if isOwner();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
