# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Google account that is allowed to read notifications (must match firestore.rules).
VITE_OWNER_EMAIL=roshankurshankmb@gmail.com

# Gemini API key for the portfolio chatbot (https://aistudio.google.com/apikey).
# NOTE: this key ships in the public JS bundle - restrict it to your site's
# HTTP referrers in Google Cloud console -> APIs & Services -> Credentials.
VITE_GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
VITE_GEMINI_MODEL=
